# ── Site ────────────────────────────────────────────────────────
# Used for constructing Stripe success/cancel URLs and in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Workshops registrations DB) ───────────────────────
# Server-only. Never expose the service role key to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Workshop checkout) ──────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys (use test keys locally).
STRIPE_SECRET_KEY=
# Signing secret for the /api/workshops/stripe-webhook endpoint.
# Locally: `stripe listen --forward-to localhost:3000/api/workshops/stripe-webhook`
STRIPE_WEBHOOK_SECRET=

# ── Zoom (Server-to-Server OAuth) ───────────────────────────────
# Create an S2S OAuth app in the Zoom Marketplace.
# Required scopes: meeting:read:admin, meeting:write:admin, meeting:write:registrant:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── Resend (Email) ──────────────────────────────────────────────
# Already used for /api/contact. https://resend.com/api-keys
RESEND_API_KEY=

# ── Cron auth ───────────────────────────────────────────────────
# Any random string. Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
